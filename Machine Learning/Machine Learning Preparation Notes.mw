<Group view="presentation" inline-output="false" labelreference="L1014" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field style="Text" layout="Normal">As can be seen from the very common example shown here, high bias is far from the center, while high variance scatters data all over</Text-field>
